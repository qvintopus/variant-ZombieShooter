[sub_resource type="Resource" id="Resource_webhealth"]
script = ExtResource("4_health")
hp = 1.0
max_hp = 1.0
reset_hp = 1.0
reset_max_hp = 1.0
is_dead = false
version = 0
not_saved = false

[sub_resource type="Resource" id="Resource_webhealth_item"]
resource_name = "health"
script = ExtResource("3_item")
resource = SubResource("Resource_webhealth")
make_unique = true
description = "Web dies when a shot hits it."

[sub_resource type="Resource" id="Resource_webdamage"]
script = ExtResource("5_damage")
can_receive_damage = true
ignores_melee = true
version = 0
not_saved = false

[sub_resource type="Resource" id="Resource_webdamage_item"]
resource_name = "damage"
script = ExtResource("3_item")
resource = SubResource("Resource_webdamage")
make_unique = true
description = "Receives shots."

[sub_resource type="Resource" id="Resource_webzone"]
script = ExtResource("10_zone")
transmission_name = &"zone"
